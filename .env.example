# === 应用安全与服务 ===
PORT=7860
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=

# === 数据库（生产环境填 Neon PostgreSQL，留空自动使用本地 SQLite） ===
DATABASE_URL=

# === 三平台数据采集源（TikHub 一套打通 TK + INS + YT） ===
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
# 可选：若填了官方 YouTube Data API v3 Key，YouTube 将优先走免费官方接口
YOUTUBE_API_KEY=

# === AI 大脑配置（默认 Gemini 2.5 Flash，原生看视频最省 Token） ===
AI_PROVIDER=gemini
GEMINI_API_KEY=
# 可选：支持填写兼容中转地址（如支持支付宝/微信的聚合中转站），留空直连 Google 官方
GEMINI_BASE_URL=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_DEEP_MODEL=gemini-3.5-flash

# 可选兜底：当 AI_PROVIDER=openai_compatible 时生效
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_DEEP_MODEL=gpt-4o

# === V2.0 一键商品生图（支持最新 GPT Image 2.6 Sunburst/Flare & Gemini 原生生图） ===
IMAGE_PROVIDER=gemini
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst

# === V2.0 可灵 Kling 一键图生视频（若已配置 302.ai 生图 Key 会自动共用，无需重复填；也可单独配官方 AK/SK 或中转 Key） ===
KLING_API_BASE_URL=https://api-beijing.klingai.com
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_KEY=
KLING_MODEL_NAME=kling-v3
KLING_MODE=std

# === 调试开关（生产环境必须为 false） ===
ENABLE_MOCK_MODE=false
